# Terraform state files
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Runtime cache (live vcenter inventory snapshots)
.cache/

# Secure credentials (everything under secure/ — except README, see below)
secure/*

# IPAM state files
*.ip

# Per-VM deploy configs — contain real inventory/SSH key/IPs.
# Kept local (never pushed to GitHub); one file per VM.
# Layout: deploy/<vcenter>/<env>/vm-<name>_<ip>.tfvars (new)
# Legacy flat layout kept parallel: deploy/<env>/vm-<name>_<ip>.tfvars
deploy/*/*/vm-*.tfvars
deploy/*/vm-*.tfvars
# Demo vCenter (dc_example_192.0.2.10) — DUMMY data, committed so the
# real deploy/<vcenter>/<env>/vm-<name>_<ip>.tfvars layout is visible.
!deploy/dc_example_192.0.2.10/
!deploy/dc_example_192.0.2.10/**

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI output
*.tfplan
*.tfplan.*
*_console_output.txt

# OS files
.DS_Store
Thumbs.db

# secure/ is encrypted secrets — README is safe to commit
secure/*
!secure/README.md
# Demo vCenter (dc_example_192.0.2.10) — DUMMY data, committed so readers/
# operators can see the real secure/ layout. Never point this at real infra.
!secure/dc_example_192.0.2.10/
!secure/dc_example_192.0.2.10/**

# plaintext staging area for sops-encrypt.sh — never commit
.tmp-sops-plain/

# Internal docs — kept local (blueprint / operator guides / deployment history), never published
PROJECT_STATUS.md
docs/
deploy/how_to_deploy.md

# sops age key copy — synced to private repo only (see scripts sync)
sops-age/

# Web UI job backups (tar.gz of deploy/ + terraform/)
backups/

# git helper files (sync script etc.) — internal, backed up to private snapshot only
github/

# vmpilot-webui secrets & build artifacts
vmpilot-webui/.env
vmpilot-webui/.env.*
!vmpilot-webui/.env.example
vmpilot-webui/**/node_modules/
vmpilot-webui/**/dist/
vmpilot-webui/nginx/certs/
vmpilot-webui/config/secrets.env
vmpilot-webui/data/
!vmpilot-webui/config/secrets.env.example
