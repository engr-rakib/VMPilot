
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://192.168.20.20:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "auto/best-coding": {
          "name": "Auto Best Coding",
          "limit": {
            "context": 2000000,
            "output": 1048576
          },
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  },
  "model": "omniroute/auto/best-coding"
}
