# ─────────────────────────────────────────────────────────────────────────────
# VMPilot WebUI — Compose environment (non-secret only)
# Copy to .env and fill in.
#   cp .env.example .env
#
# SECRETS: the bcrypt password hash lives in config/secrets.env (NOT here),
# because Compose interpolates `$` in .env values and would corrupt it.
# ─────────────────────────────────────────────────────────────────────────────

# VMPilot repo root, relative to this compose file (vmpilot-webui/ is inside it).
VMPILOT_DIR=../

# Host ports
# WEBUI_PORT is used by the Node server in standalone mode (no nginx).
WEBUI_PORT=3000
# WEBUI_HTTP_PORT / WEBUI_HTTPS_PORT are only used with the optional nginx
# profile (docker compose --profile nginx up -d).
WEBUI_HTTP_PORT=80
WEBUI_HTTPS_PORT=443

# Login user (single admin in Phase 1; RBAC comes in Phase 3)
WEBUI_USER=admin

# JWT signing secret — generate with:  openssl rand -hex 32
WEBUI_SECRET=

# Session lifetime (hours)
WEBUI_SESSION_HOURS=8

# UID/GID the web terminal shell runs as (1000 = normal user on most hosts)
TERMINAL_UID=1000
TERMINAL_GID=1000