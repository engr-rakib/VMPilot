# VMPilot WebUI secrets — read LITERALLY by the Node app.
# WARNING: never put these values in docker-compose `environment:` or Compose's
# .env — Compose interpolates `$`, which corrupts bcrypt hashes.

# bcrypt hash of the admin password. Generate with:
#   node server/scripts/gen-pass.js                 (interactive)
#   node server/scripts/gen-pass.js "S3cret!"       (one-shot)
WEBUI_PASS_HASH=
